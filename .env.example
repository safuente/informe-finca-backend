# App
APP_NAME=informe-finca-backend
DEBUG=false
ENVIRONMENT=local

# URL pública de esta API (se usa para construir el enlace de descarga del informe)
PUBLIC_BASE_URL=http://localhost:8000
# Web pública en Astro (informefinca.es); origen permitido por CORS
SITE_BASE_URL=http://localhost:4321
CORS_ORIGINS=http://localhost:4321,https://informefinca.es

# Imagen de PostGIS. En Apple Silicon descoméntala: postgis/postgis solo publica amd64 y
# se ejecuta emulado (medido: 24x más lento subdividiendo geometrías). Es la misma versión
# 16-3.4, solo que compilada también para arm64, así que el volumen existente vale igual.
# POSTGIS_IMAGE=imresamu/postgis:16-3.4

# Postgres + PostGIS
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=informefinca
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis (broker de Celery)
REDIS_URL=redis://redis:6379/0

# Stripe. El webhook secret lo da `stripe listen` en local y el dashboard en producción.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Precio del informe estándar (solo necesario si creas Checkout Sessions desde la API;
# con Payment Link basta con el webhook).
STRIPE_PRICE_ID=
REPORT_PRICE_EUR=39

# Dónde se guardan los PDF generados (volumen reports_data en docker-compose)
REPORTS_DIR=/data/reports

# Identifícate ante los servicios públicos: el OVC no documenta rate limits y un
# User-Agent anónimo es lo primero que se bloquea.
HTTP_USER_AGENT=informefinca.es/1.0 (+https://informefinca.es; contacto@informefinca.es)

# Copernicus CDSE (NDVI Sentinel-2). Cuenta gratuita en dataspace.copernicus.eu.
# Sin credenciales, el informe se genera igual y omite la serie NDVI.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
NDVI_YEARS=8

# Entrega del informe por correo
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
MAIL_FROM=contacto@informefinca.es
MAIL_FROM_NAME=informefinca.es

# Vista previa gratuita: límite por IP y hora (protege al OVC, no a nosotros)
PREVIEW_RATE_LIMIT=20
# Días que se cachean los datos catastrales antes de volver a preguntar al OVC
PARCEL_CACHE_DAYS=30
