# Caddy consigue el certificado de Let's Encrypt y lo renueva solo, y reenvía al contenedor
# de la API. Se elige frente a nginx por eso: con nginx hay que montar certbot y un cron, y
# un certificado caducado un domingo es una caída total sin nadie de guardia.
#
# Montaje previsto: el registro DNS de api.informefinca.es apunta DIRECTO a este servidor
# (en Cloudflare, nube gris / «DNS only»). Cloudflare sigue siendo el DNS del dominio, pero
# no se interpone en el tráfico. Así la IP que ve la API es la del visitante de verdad, sin
# cabeceras de por medio, y el limitador de la vista previa —lo que protege nuestro acceso
# al Catastro— funciona sin poder falsearse.
#
# Si algún día hace falta encender el proxy de Cloudflare (nube naranja), son DOS cambios y
# van juntos o ninguno:
#   1. aquí, `reverse_proxy app:8000 { header_up X-Forwarded-For {http.request.header.CF-Connecting-IP} }`
#      porque con el proxy la X-Forwarded-For que llega la puede haber escrito el visitante;
#   2. en el cortafuegos, admitir 80 y 443 solo desde los rangos de Cloudflare, para que
#      nadie pueda conectarse directo a la IP del servidor y mandar cabeceras inventadas.
# Con solo el punto 1, saltarse el límite sería tan fácil como cambiar de IP en cada
# petición.
api.informefinca.es {
	reverse_proxy app:8000

	encode gzip

	# Los orígenes permitidos los aplica FastAPI con CORS_ORIGINS; esto es defensa en
	# profundidad de cabeceras.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}

# ─────────────────────────────────────────────────────────────────────────────
# Web pública (Astro estático). Se sirve desde este mismo Caddy porque los
# puertos 80 y 443 ya están ocupados por él: un segundo contenedor no podría
# escucharlos. Los ficheros llegan por rsync desde el Mac a /opt/informefinca-web,
# montado como /srv/web de solo lectura. No hay build ni Node en el servidor.
#
# Al contrario que api., aquí la nube naranja de Cloudflare SÍ interesa cuando se
# quiera CDN: este bloque no depende de la IP del visitante. Si se enciende, hay
# que poner SSL/TLS en «Full (strict)» a la vez, o Cloudflare entra por HTTP,
# Caddy redirige a HTTPS y se forma un bucle.
informefinca.es {
	root * /srv/web
	encode zstd gzip

	# Astro genera una carpeta por página con su index.html, así que file_server
	# resuelve las URLs con barra final tal cual. Solo falta la página de error.
	handle_errors {
		rewrite * /404.html
		file_server
	}

	# Los assets llevan hash en el nombre y las fuentes no cambian nunca: un año
	# de caché es gratis. El HTML corto, para que una corrección de precio o de
	# texto legal no se quede pegada en el navegador de nadie.
	@immutable path /_astro/* /fonts/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	@html path *.html /
	header @html Cache-Control "public, max-age=300, must-revalidate"

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	file_server
}

# www al dominio principal: dos hosts sirviendo lo mismo parten el SEO.
www.informefinca.es {
	redir https://informefinca.es{uri} permanent
}
